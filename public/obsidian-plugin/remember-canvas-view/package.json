{
  "name": "remember-canvas-view",
  "version": "0.1.0",
  "description": "Restore the last viewport for each Obsidian Canvas.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "keywords": ["obsidian", "canvas", "viewport"],
  "author": "sunb256",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.15.17",
